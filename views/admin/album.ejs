<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shared Album - <%= wedding.groom_name %> & <%= wedding.bride_name %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Great+Vibes&family=Lato:wght@300;400&display=swap" rel="stylesheet">
</head>
<body class="admin-dashboard">
    <header class="admin-header">
        <div class="header-content" style="position: relative;">
            <h1>Shared Album</h1>
            
            <div class="header-actions">
                <span class="photo-count-text" style="color: #888; margin-right: 20px; font-size: 0.9rem;"><%= photos.length %> Photos</span>
                
                <button class="hamburger-btn" onclick="document.getElementById('nav-links').classList.toggle('active')">
                    &#9776;
                </button>
                
                <div class="nav-links" id="nav-links">
                    <a href="/admin/qr" class="btn-text" style="text-decoration: none;">QR Code</a>
                    <form action="/admin/logout" method="POST" style="margin: 0;">
                        <button type="submit" class="btn-text">Logout</button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <main class="dashboard-content">

        <div class="search-container">
            <input type="text" id="guestSearch" placeholder="Search for a guest..." onkeyup="filterGuests()">
        </div>

        <div class="guest-folders-grid" id="guestFoldersGrid">
            <% if (photos && photos.length > 0) { %>
                <% 
                   const groupedPhotos = {};
                   photos.forEach(photo => {
                       const name = photo.guest_name || 'Anonymous';
                       if (!groupedPhotos[name]) groupedPhotos[name] = [];
                       groupedPhotos[name].push(photo);
                   });
                %>
                <% Object.keys(groupedPhotos).forEach((guestName, index) => { 
                    const guestPhotos = groupedPhotos[guestName];
                    const coverPhoto = guestPhotos[0];
                    const folderId = 'folder-' + index;
                %>
                    <div class="guest-folder-card" data-guest-name="<%= guestName.replace(/"/g, '&quot;') %>" onclick="openModal('<%= folderId %>')">
                        <div class="folder-cover">
                            <img src="https://<%= process.env.SUPABASE_URL.replace('https://', '') %>/storage/v1/object/public/wedding-photos/<%= coverPhoto.thumbnail_path %>" alt="Cover by <%= guestName %>">
                            <div class="folder-count"><%= guestPhotos.length %></div>
                        </div>
                        <div class="folder-meta">
                            <h3><%= guestName %></h3>
                            <span>Last updated: <%= new Date(coverPhoto.created_at).toLocaleDateString() %></span>
                        </div>
                    </div>
                    
                    <!-- Modal for this guest -->
                    <div class="folder-modal" id="<%= folderId %>" style="display: none;">
                        <div class="folder-modal-content">
                            <div class="folder-modal-header">
                                <h2>Captures by <%= guestName %></h2>
                                <span class="close-modal" onclick="closeModal('<%= folderId %>')">&times;</span>
                            </div>
                            <div class="masonry-grid">
                                <% guestPhotos.forEach(photo => { 
                                    const fullUrl = `https://${process.env.SUPABASE_URL.replace('https://', '')}/storage/v1/object/public/wedding-photos/${photo.storage_path}`;
                                    const thumbUrl = `https://${process.env.SUPABASE_URL.replace('https://', '')}/storage/v1/object/public/wedding-photos/${photo.thumbnail_path}`;
                                    const timeStr = new Date(photo.created_at).toLocaleString();
                                %>
                                    <div class="masonry-item" id="photo-<%= photo.id %>" onclick="openImageViewer('<%= fullUrl %>', '<%= photo.id %>', '<%= timeStr %>')">
                                        <img src="<%= thumbUrl %>" loading="lazy" alt="Capture">
                                    </div>
                                <% }); %>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="text-align: center; width: 100%; color: #888;">No photos have been uploaded yet.</p>
            <% } %>
        </div>
    </main>

    <!-- Global Image Viewer Modal -->
    <div class="viewer-modal" id="imageViewerModal" style="display: none;">
        <div class="viewer-backdrop" onclick="closeImageViewer()"></div>
        <span class="close-viewer" onclick="closeImageViewer()">&times;</span>
        <div class="viewer-content-wrapper">
            <img id="viewerImage" src="" alt="Full view">
            <div class="viewer-controls">
                <span id="viewerTime" class="viewer-time"></span>
                <div class="viewer-actions">
                    <button id="viewerDownloadBtn" class="btn-viewer">Download</button>
                    <button id="viewerDeleteBtn" class="btn-viewer btn-viewer-danger">Delete</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openModal(id) {
            document.getElementById(id).style.display = 'block';
            document.body.style.overflow = 'hidden';
        }
        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        function filterGuests() {
            const query = document.getElementById('guestSearch').value.toLowerCase();
            const cards = document.querySelectorAll('.guest-folder-card');
            let found = false;
            
            cards.forEach(card => {
                const name = card.getAttribute('data-guest-name').toLowerCase();
                if (name.includes(query)) {
                    card.style.display = 'block';
                    found = true;
                } else {
                    card.style.display = 'none';
                }
            });

            // Optional: show a message if nothing found, but for now just hide the cards.
        }

        async function forceDownload(url, filename) {
            try {
                const btn = document.getElementById('viewerDownloadBtn');
                const originalText = btn.innerText;
                btn.innerText = 'Downloading...';
                btn.disabled = true;

                const response = await fetch(url);
                const blob = await response.blob();
                const blobUrl = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = blobUrl;
                a.download = filename || 'wedding-photo.jpg';
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(blobUrl);
                document.body.removeChild(a);

                btn.innerText = originalText;
                btn.disabled = false;
            } catch (e) {
                console.error('Download failed', e);
                window.open(url, '_blank');
            }
        }

        function openImageViewer(imgUrl, photoId, timeStr) {
            document.getElementById('viewerImage').src = imgUrl;
            document.getElementById('viewerTime').innerText = timeStr;
            
            const dlBtn = document.getElementById('viewerDownloadBtn');
            dlBtn.onclick = function(e) {
                e.preventDefault();
                forceDownload(imgUrl, `wedding_photo_${photoId}.jpg`);
            };

            const delBtn = document.getElementById('viewerDeleteBtn');
            delBtn.onclick = function(e) {
                e.preventDefault();
                deletePhoto(photoId);
            };
            
            document.getElementById('imageViewerModal').style.display = 'flex';
        }

        function closeImageViewer() {
            document.getElementById('imageViewerModal').style.display = 'none';
        }

        async function deletePhoto(id) {
            if (!confirm('Are you sure you want to delete this photo?')) return;
            
            try {
                const response = await fetch(`/admin/photos/${id}/delete`, { 
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                
                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        const el = document.getElementById(`photo-${id}`);
                        if (el) el.remove();
                        closeImageViewer();
                    } else {
                        alert('Failed: ' + result.error);
                    }
                } else {
                    const text = await response.text();
                    alert('Server error: ' + response.status + ' ' + text);
                }
            } catch (err) {
                console.error(err);
                alert('Network error deleting photo: ' + err.message);
            }
        }
    </script>
</body>
</html>
