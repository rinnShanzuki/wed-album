<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Code - <%= wedding.groom_name %> & <%= wedding.bride_name %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Great+Vibes&family=Lato:wght@300;400&display=swap" rel="stylesheet">
</head>
<body class="admin-dashboard">
    <header class="admin-header">
        <div class="header-content" style="position: relative;">
            <h1><a href="/admin/album" class="back-link" style="text-decoration: none;">&larr;</a> &nbsp;QR Code</h1>
            
            <div class="header-actions">
                <button class="hamburger-btn" onclick="document.getElementById('nav-links').classList.toggle('active')">
                    &#9776;
                </button>
                
                <div class="nav-links" id="nav-links">
                    <form action="/admin/logout" method="POST" style="margin: 0;">
                        <button type="submit" class="btn-text">Logout</button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <main class="dashboard-content">
        <div class="qr-container">
            <h2><%= wedding.groom_name %> & <%= wedding.bride_name %></h2>
            <p>Scan to capture and share our wedding memories.</p>
            
            <% if (qrDataUrl) { %>
                <img src="<%= qrDataUrl %>" alt="Wedding QR Code" class="qr-image">
                <a href="<%= qrDataUrl %>" download="<%= wedding.slug %>-qr.png" class="btn-primary">Download QR</a>
            <% } else { %>
                <p>Failed to generate QR code.</p>
            <% } %>
        </div>
    </main>
</body>
</html>
