<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Your Name - <%= wedding.groom_name %> & <%= wedding.bride_name %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/guest.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Great+Vibes&family=Lato:wght@300;400&display=swap" rel="stylesheet">
</head>
<body class="welcome-bg">
    <div class="env-stage">
        <div class="env-glow"></div>
        
        <div class="vertical-card name-card-custom">
            <div class="vertical-card-inner-border"></div>
            
            <div class="name-header-custom">
                <h1 class="name-title">Welcome ❤️</h1>
                <p class="name-desc">
                    Before you capture a moment,<br>
                    tell us your name.
                </p>
            </div>
            
            <form action="/w/<%= wedding.slug %>/name" method="POST" class="name-form">
                <div class="name-input-wrapper">
                    <input type="text" name="guestName" placeholder="Your name" required autofocus autocomplete="name" class="name-input">
                </div>
                
                <button type="submit" class="name-btn-continue">CONTINUE &rarr;</button>
            </form>
        </div>
    </div>
</body>
</html>
