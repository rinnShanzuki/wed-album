<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Success - <%= wedding.groom_name %> & <%= wedding.bride_name %></title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/guest.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Great+Vibes&family=Lato:wght@300;400&display=swap" rel="stylesheet">
</head>
<body class="welcome-bg">
    <div class="env-stage">
        <div class="env-glow"></div>
        
        <div class="vertical-card" style="min-height: 400px; justify-content: center; padding: 3rem 2rem;">
            <div class="vertical-card-inner-border"></div>
            
            <div style="text-align: center; width: 100%;">
                
                <h1 class="name-title">Memory Shared!</h1>
                
                <p class="name-desc" style="margin-bottom: 2rem;">
                    Your photo is now part of<br>
                    <%= wedding.groom_name %> & <%= wedding.bride_name %>'s album.
                </p>
            </div>
            
            <div class="action-buttons-custom">
                <a href="/w/<%= wedding.slug %>/camera" class="name-btn-continue">TAKE ANOTHER PHOTO</a>
                <a href="/w/<%= wedding.slug %>/album" class="name-btn-secondary">VIEW ALBUM</a>
            </div>
        </div>
    </div>
</body>
</html>
